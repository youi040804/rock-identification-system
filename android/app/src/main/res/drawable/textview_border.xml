<!-- 在drawable文件夹中创建一个名为textview_border.xml的文件 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="#00000000" /> <!-- 这是内部填充颜色，透明表示没有填充 -->
    <stroke android:width="2dp" android:color="#FF0000FF" /> <!-- 边框颜色和宽度 -->
    <padding android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp" /> <!-- 边框内部的填充 -->
    <corners android:radius="4dp" /> <!-- 边框的圆角半径 -->
</shape>
